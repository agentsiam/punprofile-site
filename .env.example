# Convex deployment URL — public, safe for client. Set automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Server-only. Used for `npx convex deploy` in CI/CD (Vercel build step).
#
# The `build` script in package.json branches on this: set, it deploys the
# Convex functions and then builds Next; unset, it just builds Next. That is
# deliberate. The build command used to live in Vercel's project settings, so
# a project without the key failed the build outright and a project without
# the setting silently stopped deploying `convex/` at all. Now the repo owns
# the rule, and pasting the key into Vercel is the whole switch.
#
# Leave it unset locally. `npm run build` on a laptop should build the site,
# not push functions to production.
CONVEX_DEPLOY_KEY=

# Convex environment variable, not a Next.js one — set via:
#   npx convex env set RESEND_API_KEY <value> --prod
# Documented here for visibility only; do not read it from process.env in Next.js code.
# Used by convex/notify.ts to tell the coach a lead arrived. Unset means no
# notification and no error. The message carries no candidate details, so no
# sending domain has to be verified: Resend's shared onboarding@resend.dev
# delivers to the account owner's own address, which is the only recipient.
# RESEND_API_KEY=

# PostHog analytics — must be configured with person_profiles: 'identified_only'
# and no autocapture of form input values (PRD § 2 Security Considerations).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# The one origin the site claims as its own: canonical URLs, hreflang, the
# sitemap, robots.txt, llms.txt and every JSON-LD block. `src/lib/seo.ts` reads
# it and falls back to the old punprofile.vercel.app address, so the domain
# move is this variable and nothing else.
SITE_URL=https://punprofile.app

# Set on the RETIRED project only, never on the live one. When present, every
# path 308s to it, which is how punprofile.vercel.app hands its traffic and its
# search ranking to the new domain instead of serving a second copy of the site.
# Unsetting it is the rollback. See the comment in next.config.ts.
REDIRECT_TO=

# The admin allowlist: comma-separated, lower-cased, and the ONLY addresses that
# can create a Convex Auth account or pass `requireAdmin`. No public sign-up
# path exists. A Convex environment variable, not a Next.js one:
#   npx convex env set -- ADMIN_EMAILS "a@example.com,b@example.com" --prod
# Removing an address revokes access on the next call, not at the next sign-in.
ADMIN_EMAILS=

# The single address that receives the new-lead alert from convex/notify.ts.
# Separate from the allowlist on purpose: adding an admin must not change who
# gets emailed. Also read as a fallback allowlist entry, so an old deployment
# that only has this one set still works.
ADMIN_EMAIL=

# Where the result page's consultation CTA points (TASK-046). The CTA is hidden
# entirely while this is unset, rather than shipping a button that goes nowhere.
NEXT_PUBLIC_BOOKING_URL=

# Local development only: skips the sign-in gate on /admin. Two switches, both
# required, and neither can be turned on globally.
#
#   NEXT_PUBLIC_DEV_ADMIN_BYPASS=1        here, in .env.local (gitignored)
#   npx convex env set DEV_ADMIN_BYPASS <deployment-name>
#
# The Convex one must NAME the deployment it is allowed on, and is compared
# against the deployment actually running the code, so copying it to production
# does nothing. Leave both unset everywhere except a local machine.
NEXT_PUBLIC_DEV_ADMIN_BYPASS=
